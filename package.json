{
  "name": "trellis-board",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "board": "node server/index.js",
    "start": "node server/index.js",
    "build": "npm --prefix web run build",
    "web:dev": "npm --prefix web run dev",
    "capacity": "node scripts/team-capacity-check.js",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "node --test tests/*.test.js",
    "test:plugins": "node --test plugins/*/test/*.test.js",
    "test:all": "node --test tests/*.test.js plugins/*/test/*.test.js"
  },
  "dependencies": {
    "@mindfoldhq/trellis": "0.6.17"
  },
  "devDependencies": {
    "oxfmt": "^0.77.0"
  },
  "engines": {
    "node": ">=24"
  }
}
