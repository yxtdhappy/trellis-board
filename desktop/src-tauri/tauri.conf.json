{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Trellis Board",
  "version": "0.2.0",
  "identifier": "com.trellisboard.client",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-ancestors 'none'",
      "capabilities": [
        "main",
        "board-local-association",
        "live-control"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/trellis-agent"
    ],
    "resources": {
      "resources/trellis-runtime/": "trellis-runtime/"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerHooks": "./windows/hooks.nsh",
        "languages": [
          "SimpChinese",
          "English"
        ]
      }
    }
  }
}
