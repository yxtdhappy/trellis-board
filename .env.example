# 仓库根已有默认 .env（team 模式，已入库）；本文件是同一套键的模板/说明。
# 命令行环境变量优先于 .env，本文件不会被服务端读取。

# Jenkins 读取的 Node 版本（首行约定）
node_version=24

# HTTP 端口，默认 4317
PORT=4317

# 唯一支持 team；standalone 代码已移除，其他值启动时报错
TRELLIS_BOARD_MODE=team

# 运行数据目录；留空使用系统用户数据目录（必须位于源码工作树之外）
TRELLIS_BOARD_DATA_DIR=

# 插件配置目录（plugins.json / secrets / logs）；留空时默认 <用户数据根>/plugins，
# 设置 TRELLIS_BOARD_DATA_DIR 时退化为 <数据目录>/plugins
TRELLIS_BOARD_PLUGINS_DIR=

# 桌面客户端自动更新包托管目录（存放 latest.json 与 TrellisBoard_<version>_x64-portable.zip）；
# 留空时默认 <TRELLIS_BOARD_DATA_DIR>/client-updates
TRELLIS_CLIENT_UPDATES_DIR=

# Team 服务端插件已固定关闭，以下键仅为兼容旧部署保留，配置也不会启用服务端插件。
TRELLIS_TEAM_PLUGINS_ALLOWLIST=
TRELLIS_PLUGINS_DISABLED=1

# 任务文件监听防抖毫秒，最低 100
TRELLIS_WATCH_DEBOUNCE_MS=400
