{
  "$schema": "../gen/schemas/remote-schema.json",
  "identifier": "board-local-association",
  "description": "远程 Board 仅可列出本地关联并选择本地仓库，Rust 还会复核当前 Board origin。",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "https://*:*",
      "http://*:*"
    ]
  },
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-client-identity",
    "allow-update-status",
    "allow-update-check",
    "allow-update-apply",
    "allow-desktop-logout",
    "allow-runtime-open-gate",
    "allow-associate-pending-project",
    "allow-cancel-pending-project",
    "allow-check-pending-project-push",
    "allow-commit-and-push-pending-project",
    "allow-detach-local-association",
    "allow-initialize-pending-project",
    "allow-inspect-company-spec",
    "allow-plan-company-spec",
    "allow-apply-company-spec",
    "allow-inspect-local-project",
    "allow-initialize-associated-project-agents",
    "allow-inspect-associated-project-agents",
    "allow-inspect-associated-project-branches",
    "allow-pick-local-project-folder",
    "allow-list-local-associations",
    "allow-list-worktree-status",
    "allow-refresh-worktree-discovery",
    "allow-retry-worktree-auto-attach",
    "allow-list-task-ownership",
    "allow-set-task-ownership",
    "allow-sync-deferred-tasks",
    "allow-live-control-get",
    "allow-handoff-notice-pending",
    "allow-live-control-show",
    "allow-live-control-decide",
    "allow-live-control-diff",
    "allow-live-control-initial",
    "allow-live-control-dismiss",
    "allow-live-task-download",
    "allow-live-local-task-state",
    "allow-live-conflicts-show",
    "allow-desktop-sidecar-status",
    "allow-preflight-pending-project",
    "allow-appearance-load",
    "allow-appearance-save",
    "allow-desktop-plugins-list",
    "allow-desktop-plugin-set-enabled",
    "allow-desktop-plugin-reorder",
    "allow-desktop-plugin-logs",
    "allow-desktop-plugin-panels",
    "allow-desktop-plugin-request",
    "allow-desktop-plugin-asset",
    "allow-take-pending-share-link"
  ]
}
