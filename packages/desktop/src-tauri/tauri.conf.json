{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Trellis Board",
  "version": "0.4.46",
  "identifier": "com.trellisboard.client",
  "build": {
    "frontendDist": "../ui",
    "devUrl": "http://localhost:5199",
    "beforeDevCommand": "yarn workspace @trellis-board/web dev:desktop"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-ancestors 'none'",
      "capabilities": [
        "main",
        "board-local-association"
      ]
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
