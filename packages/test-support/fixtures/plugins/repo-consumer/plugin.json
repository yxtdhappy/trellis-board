{
  "id": "repo-consumer",
  "name": "repository consumer fixture",
  "version": "1.0.0",
  "apiVersion": 1,
  "permissions": [
    "capabilities:call",
    "repositories:read",
    "repositories:write",
    "projects:read",
    "http:route"
  ],
  "requires": [
    {
      "name": "trellis.projects",
      "version": "^1.0.0",
      "methods": ["list", "current", "branches"]
    },
    {
      "name": "trellis.repositories",
      "version": "^1.0.0",
      "methods": ["list", "add"]
    }
  ]
}
