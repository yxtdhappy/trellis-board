{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "semi": false,
  "singleQuote": true,
  "trailingComma": "all",
  "ignorePatterns": [
    "public",
    ".trellis",
    ".agents",
    ".claude",
    ".codex",
    "node_modules",
    ".github",
    "desktop/src-tauri",
    "**/*.md",
    "*.pen"
  ]
}
