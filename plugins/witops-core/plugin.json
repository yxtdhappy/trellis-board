{
  "id": "witops-core",
  "name": "WitOps 核心能力",
  "description": "提供 WitOps 需求、任务树、工时、状态更新与任务下发到 Trellis 的标准 capability。",
  "version": "2.0.0",
  "apiVersion": 1,
  "targets": [
    "desktop"
  ],
  "allowMissingSecrets": true,
  "engines": {
    "board": ">=0.2.0"
  },
  "permissions": [
    "capabilities:provide",
    "capabilities:call",
    "tasks:read",
    "projects:read",
    "user:read",
    "tasks:write",
    "store",
    "events",
    "http:route",
    "panels",
    "schedule",
    "runs:read",
    "runs:write",
    "secrets:read",
    "secrets:write"
  ],
  "provides": [
    {
      "name": "witops.workitems",
      "version": "1.0.0",
      "methods": {
        "mine": {
          "access": "read",
          "timeoutMs": 15000
        },
        "requirement.get": {
          "access": "read",
          "timeoutMs": 10000
        },
        "requirement.query": {
          "access": "read",
          "timeoutMs": 30000
        },
        "requirement.resolve": {
          "access": "read",
          "timeoutMs": 60000
        },
        "requirement.tree": {
          "access": "read",
          "timeoutMs": 20000
        },
        "task.listByRequirement": {
          "access": "read",
          "timeoutMs": 30000
        },
        "task.get": {
          "access": "read",
          "timeoutMs": 10000
        }
      }
    },
    {
      "name": "witops.worklogs",
      "version": "1.0.0",
      "methods": {
        "summary": {
          "access": "read",
          "timeoutMs": 30000
        }
      }
    },
    {
      "name": "witops.actions",
      "version": "1.0.0",
      "methods": {
        "requirement.updateStatus": {
          "access": "write",
          "timeoutMs": 10000
        },
        "task.updateStatus": {
          "access": "write",
          "timeoutMs": 10000
        },
        "task.assign": {
          "access": "write",
          "timeoutMs": 10000
        }
      }
    },
    {
      "name": "witops.dispatch",
      "version": "1.0.0",
      "methods": {
        "preview": {
          "access": "read",
          "timeoutMs": 120000
        },
        "task.create": {
          "access": "write",
          "timeoutMs": 120000
        },
        "task.batchCreate": {
          "access": "write",
          "timeoutMs": 180000
        },
        "task.syncRecent": {
          "access": "write",
          "timeoutMs": 180000
        },
        "imported.list": {
          "access": "read",
          "timeoutMs": 10000
        },
        "auth.login": {
          "access": "write",
          "timeoutMs": 30000
        },
        "auth.logout": {
          "access": "write",
          "timeoutMs": 10000
        },
        "auth.status": {
          "access": "read",
          "timeoutMs": 10000
        }
      }
    }
  ],
  "requires": [
    {
      "name": "accounts.credentials",
      "version": "^1.0.0",
      "methods": [
        "credential.resolve"
      ]
    },
    {
      "name": "trellis.projects",
      "version": "^1.0.0",
      "methods": [
        "list",
        "get",
        "current",
        "branches",
        "developers"
      ]
    },
    {
      "name": "trellis.user",
      "version": "^1.0.0",
      "methods": [
        "current"
      ]
    }
  ],
  "panels": [
    {
      "id": "witops-core",
      "title": "WitOps 任务",
      "entry": "/panel",
      "placement": "view",
      "order": 25
    }
  ],
  "config": {}
}
