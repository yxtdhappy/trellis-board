{
  "id": "acp-dispatch",
  "name": "acp dispatch",
  "version": "1.0.0",
  "apiVersion": 1,
  "engines": {
    "board": ">=0.2.0"
  },
  "permissions": ["tasks:read", "store", "events", "http:route", "runs:read", "runs:write"],
  "http": {
    "rootPaths": []
  },
  "config": {
    "agent": "opencode",
    "command": "",
    "args": [],
    "cwd": "",
    "permission": {
      "default": "allow",
      "byKind": {
        "delete": "deny",
        "fetch": "deny",
        "switch_mode": "deny"
      }
    },
    "runTimeoutMs": 1800000,
    "maxConcurrent": 1,
    "retryFailed": false,
    "rerunSucceeded": false,
    "idleTimeoutMs": 600000
  }
}
