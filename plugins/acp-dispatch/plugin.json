{
  "id": "acp-dispatch",
  "name": "ACP 派发",
  "description": "把 Trellis 任务派发给 ACP Agent 执行，并在「Agent 派发」面板展示运行状态。",
  "version": "1.1.0",
  "apiVersion": 1,
  "targets": [
    "desktop"
  ],
  "engines": {
    "board": ">=0.2.0"
  },
  "permissions": [
    "tasks:read",
    "store",
    "events",
    "events:emit",
    "events:publish",
    "http:route",
    "panels",
    "runs:read",
    "runs:write"
  ],
  "panels": [
    {
      "id": "agent",
      "title": "Agent 派发",
      "entry": "/panel",
      "placement": "view",
      "order": 20
    }
  ],
  "config": {}
}
