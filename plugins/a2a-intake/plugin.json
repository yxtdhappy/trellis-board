{
  "id": "a2a-intake",
  "name": "a2a intake",
  "version": "1.0.0",
  "apiVersion": 1,
  "engines": {
    "board": ">=0.2.0"
  },
  "permissions": [
    "tasks:read",
    "tasks:write",
    "store",
    "http:root"
  ],
  "http": {
    "rootPaths": [
      "/a2a",
      "/.well-known/agent-card.json",
      "/.well-known/agent.json"
    ],
    "openPaths": [
      "/.well-known/agent-card.json",
      "/.well-known/agent.json"
    ]
  },
  "config": {
    "token": "env:A2A_TOKEN",
    "repositoryId": "",
    "defaultAssignee": "",
    "defaultPriority": "P2",
    "publicBaseUrl": "",
    "protocolVersion": "0.3.0",
    "defaultAgent": "opencode"
  }
}
