# Runtime state (local only)
.audit/
/data/

# Dependencies
node_modules/
.omp/
*.log
# No trailing slash: worktrees link public/ in as a symlink, and a
# dir-only rule (`/public/`) would leave that symlink untracked-but-visible.
/apps/server/public/

# Build and test output
coverage/
.nyc_output/
dist/
build/
test-results/
playwright-report/

# Logs
logs/

# Local tooling and caches
.playwright-mcp/
.pi/
.claude/
.cache/
.worktree/
tmp/

# Environment and secrets
.env
.env.*
!.env.example
*.pem
*.key

# Editor and OS files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# Built-in and reference plugins are published; private plugins stay local.
plugins/*
!plugins/README.md
!plugins/a2a-intake/
!plugins/a2a-intake/**
!plugins/accounts-core/
!plugins/accounts-core/**
!plugins/acp-dispatch/
!plugins/acp-dispatch/**
!plugins/jenkins-ops/
!plugins/jenkins-ops/**
!plugins/scenario-copilot/
!plugins/scenario-copilot/**
!plugins/witops-core/
!plugins/witops-core/**

# Desktop client build output
apps/desktop/src-tauri/target/
apps/desktop/src-tauri/gen/
apps/desktop/ui/
